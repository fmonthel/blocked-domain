// /etc/bind/named.conf.options - DNS resolver for WireGuard clients (10.10.10.1)
options {
	directory "/var/cache/bind";
	dnssec-validation auto;
	listen-on-v6 { any; };
	allow-recursion { 127.0.0.1; 10.10.10.0/24; };
};

// The local networks drop UDP DNS packets carrying EDNS (router issue, found 2026-10-08):
// query upstream servers over TCP only. DNSSEC validation keeps working.
server 0.0.0.0/0 { tcp-only yes; };
