// /etc/bind/named.conf.options - DNS resolver for WireGuard clients (10.10.10.1)
options {
	directory "/var/cache/bind";
	dnssec-validation auto;
	listen-on-v6 { any; };
	allow-recursion { 127.0.0.1; 10.10.10.0/24; };

	// Local overrides (split-horizon) for VPN clients: names answered with a LAN address on this
	// server only, e.g. videos.flox-arts.net -> nicomaque's LAN IP, because the router has no NAT
	// loopback. The zone file is per server and NOT in this repo: /etc/bind/db.rpz.local
	// (records on nicomaque, empty on aphrodite; it must exist). Everything else is resolved normally.
	response-policy { zone "rpz.local"; };
};

zone "rpz.local" {
	type master;
	file "/etc/bind/db.rpz.local";
	allow-query { none; };
};

// The local networks drop UDP DNS packets carrying EDNS (router issue, found 2026-10-08):
// query upstream servers over TCP only. DNSSEC validation keeps working.
server 0.0.0.0/0 { tcp-only yes; };
