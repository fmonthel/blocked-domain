# /etc/cron.d/squid-proxy - installed and kept up to date by sync-from-github.sh
# (source: scripts/squid-proxy.cron in the GitHub repo)
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# pull scripts and configs from GitHub (main)
*/15 * * * * root /root/squid/sync-from-github.sh >> /var/log/squid-sync.log 2>&1
# refresh the blocklist
0 * * * *    root /root/squid/update-squid-blocklist.sh >> /var/log/squid-blocklist.log 2>&1
# daily report e-mail at 21:00 (only sent if the kids used this proxy today)
0 21 * * *   root /usr/bin/python3 -B /root/squid/daily-squid-report.py >> /var/log/squid-report.log 2>&1
