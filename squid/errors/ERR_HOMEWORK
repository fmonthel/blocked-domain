<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Homework time!</title>
<!-- Squid error template: "%H" is the requested host; every literal percent sign must be doubled. -->
<style>
  body { margin:0; min-height:100vh; display:flex; align-items:center; justify-content:center;
         background:linear-gradient(135deg,#a5f3fc,#c4b5fd 50%%,#fbcfe8); font-family:"Segoe UI",Helvetica,Arial,sans-serif; color:#1f2937; }
  .card { background:#fff; max-width:520px; margin:24px 16px; padding:36px 32px; border-radius:24px;
          box-shadow:0 20px 50px rgba(76,29,149,.25); text-align:center; }
  .emoji { font-size:72px; line-height:1; display:inline-block; animation:bob 2.4s ease-in-out infinite; }
  @keyframes bob { 0%%,100%% { transform:translateY(0) rotate(-6deg); } 50%% { transform:translateY(-10px) rotate(6deg); } }
  h1 { font-size:28px; margin:16px 0 8px; }
  .site { display:inline-block; background:#ede9fe; color:#5b21b6; padding:2px 10px; border-radius:999px; font-weight:600; }
  p { font-size:17px; line-height:1.5; margin:12px 0; }
  .joke { background:#fef9c3; border-radius:14px; padding:14px 16px; font-size:16px; margin:20px 0; }
  .links { display:flex; gap:10px; justify-content:center; flex-wrap:wrap; margin-top:18px; }
  .links a { text-decoration:none; background:#7c3aed; color:#fff; padding:10px 16px; border-radius:12px; font-weight:600; font-size:15px; }
  .links a.alt { background:#0ea5e9; }
  .small { font-size:13px; color:#6b7280; margin-top:22px; }
</style>
</head>
<body>
<div class="card">
  <div class="emoji" id="emoji">&#128218;</div>
  <h1 id="title">Oops! This site is taking a break</h1>
  <p><span class="site">%H</span> is not available right now.</p>
  <p>Maybe it's the perfect moment to get your homework done? Games and videos will still be there afterwards, promise!</p>
  <div class="joke" id="joke">&#129300; Why was the math book sad? Because it had too many problems!</div>
  <div class="links">
    <a href="https://www.alloprof.qc.ca/">&#128161; Homework help (Alloprof)</a>
    <a class="alt" href="https://classroom.google.com/">&#127979; Google Classroom</a>
  </div>
  <div class="small">Homework done? Go show your parents, they'll be proud of you &#128522;</div>
</div>
<script>
  var faces = ["&#128218;", "&#9999;&#65039;", "&#129504;", "&#128640;", "&#129417;", "&#127775;"];
  var titles = ["Oops! This site is taking a break", "Homework time!", "Not right now, champ!",
                "Special mission: homework", "This site went out for recess"];
  var jokes = [
    "&#129300; Why was the math book sad? Because it had too many problems!",
    "&#128027; What did the snail say riding on the turtle's back? “Wheeeee!”",
    "&#127829; Fastest way to finish your homework? Start it now!",
    "&#9200; Fun fact: 20 minutes of homework now = 20 minutes less to worry about tonight!",
    "&#128013; What does a snake do after finishing its homework? It feels hiss-terical!",
    "&#129436; Why don't scientists trust atoms? Because they make up everything!",
    "&#128054; Why did the student eat his homework? The teacher said it was a piece of cake!"
  ];
  function pick(a) { return a[Math.floor(Math.random() * a.length)]; }
  document.getElementById("emoji").innerHTML = pick(faces);
  document.getElementById("title").innerHTML = pick(titles);
  document.getElementById("joke").innerHTML = pick(jokes);
</script>
</body>
</html>
