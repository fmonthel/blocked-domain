# /etc/wireguard/wg0.conf - VPN server (same key and addresses on both servers, so a phone
# can switch between them). Generate keys with:  wg genkey | tee priv | wg pubkey > pub
# NAT/forwarding: net.ipv4.ip_forward=1 and "-A POSTROUTING -o <wan-if> -j MASQUERADE"
# in /etc/ufw/before.rules; ufw allows 51820/udp and everything from 10.10.10.0/24.
[Interface]
Address = 10.10.10.1/24
ListenPort = 51820
PrivateKey = <server-private-key>

[Peer]
# iphone
PublicKey = <iphone-public-key>
AllowedIPs = 10.10.10.2/32

[Peer]
# windows
PublicKey = <windows-public-key>
AllowedIPs = 10.10.10.3/32

[Peer]
# glinet travel router
PublicKey = <glinet-public-key>
AllowedIPs = 10.10.10.4/32

# Client side (e.g. phone):
# [Interface]
# Address = 10.10.10.2/24
# DNS = 10.10.10.1
# PrivateKey = <iphone-private-key>
# [Peer]
# PublicKey = <server-public-key>
# AllowedIPs = 0.0.0.0/0
# Endpoint = <server-public-name>:51820
# PersistentKeepalive = 25
